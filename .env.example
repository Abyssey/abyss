# ============================================================================
# Abyss Multi-Agent Coding Harness — LLM Provider & Rotation Configuration
# ============================================================================

# 1. Rotation Strategy:
#    - role_based : Lead/Reviewer use strong reasoning model, Workers use fast/cost-effective model (e.g., Qwen 3.8 Flash)
#    - round_robin: Rotate across all enabled providers/keys per request to distribute rate limits
#    - fallback   : Try primary provider first; automatically fail over to next enabled provider on error/timeout
#    - single     : Use only ACTIVE_PROVIDER for all agents
ROTATION_STRATEGY=role_based
ACTIVE_PROVIDER=gemini

# 2. Core Implementation Mode:
#    - complete   : Run full reference implementation in abyss/core/
#    - guided     : Run your custom-edited logic in abyss/core/ (for hands-on practice)
ABYSS_CORE_MODE=complete

# 3. Internal / Enterprise Qwen 3.8 Flash Endpoint (OpenAI-compatible vLLM / SGLang / QwenCloud)
QWEN_ENABLED=true
QWEN_BASE_URL=http://localhost:8001/v1
QWEN_API_KEY=internal-qwen-api-key
QWEN_MODEL=qwen3.8-flash

# 4. Google Gemini API (OpenAI-compatible endpoint)
GEMINI_ENABLED=true
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# 5. OpenAI API
OPENAI_ENABLED=false
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# 6. Deterministic Mock Provider (Always available for offline demo & CI tests)
MOCK_ENABLED=true
