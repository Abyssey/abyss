# ============================================================================
# Modern Coding Agent Architecture — `langchain-ai/deepagents` Runtime Config
# ============================================================================

# 1. Server / Pod Binding
HOST=0.0.0.0
PORT=8000
# DEMO_WORKSPACE_DIR=/app/demo_workspace/repo_onboard
# INTERNAL_BARE_REMOTE=/app/demo_workspace/internal_origin.git

# 2. Internal Self-Hosted GitLab (Private VM / On-Prem / Air-Gap Pod)
#    - Local dev folders (`self`, `demo`, `/path/to/my-project`) work with ZERO config!
#    - To clone/review/push against an internal GitLab server, set URL & PAT below.
#    - Credentials are injected via Git 2.31+ `GIT_CONFIG_COUNT` env headers (never written to .git/config).
INTERNAL_GITLAB_URL=
INTERNAL_GITLAB_TOKEN=
INTERNAL_GIT_AUTH_MODE=basic_oauth2
INTERNAL_GIT_SSL_VERIFY=true
INTERNAL_GIT_CA_BUNDLE=
INTERNAL_GIT_TIMEOUT_S=30

# 3. LLM Rotation Strategy (Fail-Fast HTTP 503 when no provider has valid credentials):
#    - role_based : Lead/Reviewer use strong reasoning model, Builder/Workers use fast model
#    - round_robin: Rotate across all enabled providers/keys per request to distribute rate limits
#    - fallback   : Try primary provider first; automatically fail over to next enabled provider
#    - single     : Use only ACTIVE_PROVIDER for all agents
ROTATION_STRATEGY=role_based
ACTIVE_PROVIDER=gemini

# 4. Internal / Enterprise Qwen 3.8 Flash Endpoint (OpenAI-compatible vLLM / SGLang / QwenCloud)
#    - Set QWEN_API_KEY=EMPTY for unauthenticated internal endpoints
QWEN_ENABLED=true
QWEN_BASE_URL=http://localhost:8001/v1
QWEN_API_KEY=internal-qwen-api-key
QWEN_MODEL=qwen3.8-flash

# 5. Google Gemini API (LangChain ChatGoogleGenerativeAI)
GEMINI_ENABLED=true
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
# (Optional) Fallback Flash model when primary Gemini model encounters transient errors
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# 6. OpenAI API
OPENAI_ENABLED=false
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# 7. DeepAgent Verification & Antigravity Plan Review Policy
#    - AGENT_RUBRIC_ENABLED: true (default) runs RubricMiddleware LLM grading alongside pytest gate
#    - AGENT_PLAN_REVIEW   : request_review (default, pauses for Proceed) | always_proceed
AGENT_RUBRIC_ENABLED=true
AGENT_PLAN_REVIEW=request_review
